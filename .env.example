# Copy to .env (make does this automatically). Placeholders only: never commit real values.
# All EDISC_ variables are read by packages/core settings. Compose also reads this file.

# Deployment environment: local | ci | staging | production.
# Destructive dev helpers (make nuke) and short evidence retention only work when this is local/ci.
EDISC_ENV=local

# --- Postgres
EDISC_PG_HOST=localhost
EDISC_PG_PORT=5432
EDISC_PG_DB=edisc
EDISC_PG_SUPERUSER=postgres
EDISC_PG_SUPERUSER_PASSWORD=change-me-local-only
# Schema owner: migrations only (break-glass credential in production)
EDISC_PG_OWNER_USER=edisc_owner
EDISC_PG_OWNER_PASSWORD=change-me-local-only
# Least-privilege role the API and workers connect as (not owner, not superuser, no BYPASSRLS)
EDISC_PG_APP_USER=edisc_app
EDISC_PG_APP_PASSWORD=change-me-local-only

# Anchor sweeper login: may only list overdue anchor streams (ids)
EDISC_PG_SWEEPER_USER=edisc_sweeper
EDISC_PG_SWEEPER_PASSWORD=change-me-local-only

# App/worker sessions never hang: lock waits and abandoned transactions become retryable errors
EDISC_PG_LOCK_TIMEOUT_MS=30000
EDISC_PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Pools are fixed: a caller waits this long for a free connection, then fails loudly (API 503)
EDISC_PG_POOL_TIMEOUT_MS=10000

# --- Redis
EDISC_REDIS_URL=redis://localhost:6379/0
# Per "source.method" token buckets (JSON). Unconfigured methods are refused, never unlimited.
EDISC_RATE_LIMITS={"dummy.fetch": {"rate_per_second": 50, "burst": 10}, "dummy.expected_count": {"rate_per_second": 20, "burst": 5}, "dummy.directory": {"rate_per_second": 20, "burst": 5}, "dummy.file": {"rate_per_second": 50, "burst": 10}, "slack_export.file": {"rate_per_second": 20, "burst": 5}, "slack.oauth.v2.access": {"rate_per_second": 2, "burst": 10}, "microsoft.token": {"rate_per_second": 5, "burst": 10}, "dummy.auth_test": {"rate_per_second": 5, "burst": 5}}

# --- S3 / MinIO evidence store
EDISC_S3_ENDPOINT=http://localhost:9000
EDISC_S3_REGION=us-east-1
# Root: MinIO provisioning ONLY (compose minio + minio-init). Never in a service's settings.
EDISC_S3_ROOT_USER=change-me-local-only
EDISC_S3_ROOT_PASSWORD=change-me-local-only
# Storage identities (M18 §3): the access key is the identity's user name (bucket policies name it).
# The API and every collection/export/render/report worker: no deletes, no hold flags.
EDISC_S3_ACCESS_KEY=edisc-app
EDISC_S3_SECRET_KEY=change-me-app-local-only
# The holds worker only (`--holds`): legal-hold flags.
EDISC_S3_HOLD_ACCESS_KEY=edisc-hold
EDISC_S3_HOLD_SECRET_KEY=change-me-hold-local-only
# The destruction worker only: version deletes.
EDISC_S3_DESTROY_ACCESS_KEY=edisc-destroy
EDISC_S3_DESTROY_SECRET_KEY=change-me-destroy-local-only
EDISC_S3_EVIDENCE_BUCKET=edisc-evidence
# Unlocked staging bucket (1-day expiry): files are hashed on the way in, then copied into WORM
EDISC_S3_STAGING_BUCKET=edisc-staging
# Rolling COMPLIANCE retention window in days, extended while a matter is active
EDISC_EVIDENCE_RETENTION_WINDOW_DAYS=90
# Bucket-level default COMPLIANCE retention applied by minio-init (safety net; days).
# Compliance retention can never be shortened, so keep this tiny locally.
EDISC_S3_DEFAULT_RETENTION_DAYS=1
# Caps every object's retain-until (days). Rejected at startup unless EDISC_ENV is local/ci.
EDISC_EVIDENCE_RETENTION_OVERRIDE_DAYS=1

# --- Temporal
EDISC_TEMPORAL_ADDRESS=localhost:7233
EDISC_TEMPORAL_NAMESPACE=edisc
# Password for the dedicated `temporal` Postgres role (compose only)
TEMPORAL_DB_PASSWORD=change-me-local-only

# --- Elasticsearch (idle in Phase 1)
EDISC_ES_URL=http://localhost:9200

# --- Local KMS stub (replaced by AWS KMS later). Path to a directory of per-tenant KEKs.
EDISC_LOCAL_KMS_DIR=.local-kms

# --- Browser sessions (ADR 0016; M17). Local/test/ci use a fixed public development key when unset.
# Required outside local/test/ci: kid -> key (>= 32 bytes, JSON), and the kid used for new tokens.
# Keep the previous kid for one absolute session lifetime (12 h) after a rotation.
# EDISC_API_SESSION_KEYS={"k1": "<at least 32 random bytes, placeholder>"}
# EDISC_API_SESSION_KEY_ID=k1
# Client authentication at the IdPs (private_key_jwt): KMS RSA 3072 keys, current first; required
# outside local/test/ci (there a dev key is created in the local KMS)
# EDISC_API_CLIENT_KEYS=[{"kms_key_id": "<kms key id>", "not_before": "2026-10-15T00:00:00Z", "not_after": "2028-10-15T00:00:00Z"}]
# Job streams (SSE): replay after Last-Event-ID at most this many unit events / this old (then a reset)
# EDISC_SSE_REPLAY_MAX=10000
# EDISC_SSE_REPLAY_MAX_AGE_SECONDS=3600
# Downloads: written in pieces of at most this size; the session is re-checked between pieces
# EDISC_API_DOWNLOAD_CHUNK_BYTES=65536
# A download or stream whose write has not completed for this long is cut (reason stalled)
# EDISC_DOWNLOAD_STALL_SECONDS=60
# Directory snapshots (scope picker): captured again when this old; one run's paging budget
# EDISC_DIRECTORY_REFRESH_MAX_AGE_HOURS=24
# EDISC_DIRECTORY_REFRESH_BUDGET_SECONDS=1200
# EDISC_DIRECTORY_REFRESH_ON_CONNECT=true
# Source installs (M17 step 6): our Slack app and multi-tenant Entra app (placeholders)
# EDISC_SLACK_CLIENT_ID=<slack app client id>
# EDISC_SLACK_CLIENT_SECRET=<slack app client secret>
# EDISC_SLACK_PKCE=false
# EDISC_MICROSOFT_CLIENT_ID=<entra app client id>
# EDISC_API_OAUTH_RELAY_SUBDOMAIN=oauth
