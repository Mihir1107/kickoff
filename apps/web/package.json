{
  "name": "edisc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings=0 && node scripts/check-contrast.mjs",
    "gen:api": "cd ../.. && uv run python scripts/dump_openapi.py apps/web/openapi.json && cd apps/web && openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- openapi.json src/api/schema.gen.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@tanstack/react-query": "^5.80.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
