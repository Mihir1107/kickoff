{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DestroyVersions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/t/*",
        "arn:aws:s3:::@EVIDENCE@/custody-anchors/*"
      ]
    },
    {
      "Sid": "Versions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@"
      ]
    },
    {
      "Sid": "Certificates",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/t/*/destruction/*"
      ]
    },
    {
      "Sid": "NeverHoldFlags",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverGovernanceBypass",
      "Effect": "Deny",
      "Action": [
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverBucketConfiguration",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@",
        "arn:aws:s3:::@STAGING@"
      ]
    },
    {
      "Sid": "WritesOnlyCertificates",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "NotResource": [
        "arn:aws:s3:::@EVIDENCE@/t/*/destruction/*"
      ]
    },
    {
      "Sid": "NeverStaging",
      "Effect": "Deny",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::@STAGING@",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverDeleteMarkers",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*"
      ],
      "Condition": {
        "Null": {
          "s3:versionid": "true"
        }
      }
    }
  ]
}
