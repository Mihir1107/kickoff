{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvidenceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObjectRetention",
        "s3:GetObjectLegalHold",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/t/*",
        "arn:aws:s3:::@EVIDENCE@/custody-anchors/*"
      ]
    },
    {
      "Sid": "EvidenceBucketReads",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@"
      ]
    },
    {
      "Sid": "StagingObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::@STAGING@/t/*",
        "arn:aws:s3:::@STAGING@/exports/*"
      ]
    },
    {
      "Sid": "StagingBucketReads",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::@STAGING@"
      ]
    },
    {
      "Sid": "NeverDeleteMarkersOnEvidence",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*"
      ]
    },
    {
      "Sid": "NeverVersionDeletes",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverHoldFlags",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverGovernanceBypass",
      "Effect": "Deny",
      "Action": [
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@/*",
        "arn:aws:s3:::@STAGING@/*"
      ]
    },
    {
      "Sid": "NeverBucketConfiguration",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::@EVIDENCE@",
        "arn:aws:s3:::@STAGING@"
      ]
    },
    {
      "Sid": "EvidenceWritesOnlyUnderItsPrefixes",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject"
      ],
      "NotResource": [
        "arn:aws:s3:::@EVIDENCE@/t/*",
        "arn:aws:s3:::@EVIDENCE@/custody-anchors/*",
        "arn:aws:s3:::@STAGING@/t/*",
        "arn:aws:s3:::@STAGING@/exports/*"
      ]
    }
  ]
}
